{
  "titlebar": "none",
  "theme": {
    "light": "paper",
    "dark": "graphite"
  },
  "preview": "mods/herdr-board/preview.svg",
  "ui_font": "Geist",
  "font_size": 13,
  "background": "canvas",
  "colors": {
    "accent": "#7465db"
  },
  "terminal_padding": [
    12,
    10
  ],
  "id": "root",
  "type": "row",
  "traffic_lights": [
    12,
    16
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "my-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "board-main",
      "type": "column",
      "gap": 0,
      "resizable": false,
      "children": [
        {
          "id": "board-header",
          "type": "block",
          "size": {
            "px": 100
          },
          "window_drag": true,
          "content": {
            "mod": "herdr-board",
            "props": {
              "role": "header"
            }
          }
        },
        {
          "id": "board-split",
          "type": "column",
          "resizable": true,
          "divider": {
            "width": 1,
            "color": "#00000000",
            "hover": "accent"
          },
          "children": [
            {
              "id": "board-cards",
              "type": "block",
              "size": {
                "px": 355
              },
              "border": {
                "width": 1,
                "color": "border"
              },
              "content": {
                "mod": "herdr-board"
              },
              "min": 120,
              "max": 900
            },
            {
              "id": "workspace",
              "type": "column",
              "padding": [
                14,
                24
              ],
              "gap": 0,
              "resizable": false,
              "children": [
                {
                  "id": "workspace-title",
                  "type": "block",
                  "size": {
                    "px": 34
                  },
                  "background": "surface",
                  "radius": 7,
                  "content": {
                    "mod": "herdr-board",
                    "props": {
                      "role": "terminals"
                    }
                  }
                },
                {
                  "id": "workspace-body",
                  "type": "row",
                  "gap": 12,
                  "padding": 0,
                  "children": [
                    {
                      "id": "live-terminals",
                      "type": "block",
                      "background": "surface",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "gap": 12,
                          "radius": 7,
                          "background": "background",
                          "lone": true,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "header": {
                            "content": {
                              "mod": "herdr-board",
                              "props": {
                                "role": "pane"
                              }
                            },
                            "height": 28,
                            "position": "top",
                            "reveal": "always"
                          }
                        }
                      },
                      "min": 240
                    },
                    {
                      "id": "tab-notes",
                      "type": "block",
                      "size": {
                        "px": 340
                      },
                      "min": 240,
                      "max": 700,
                      "content": {
                        "mod": "tab-notes"
                      }
                    }
                  ]
                }
              ],
              "min": 180
            }
          ]
        }
      ]
    }
  ],
  "font": "D2Coding"
}